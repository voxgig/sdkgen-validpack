new file mode 100644
index 0000000..3b3443d
--- /dev/null
+++ b/.github/workflows/build.yml
@@ -0,0 +1,106 @@
+# Builds and tests this pack on every change, and on a schedule.
+#
+# THE SCHEDULE MATTERS AS MUCH AS THE PUSH. The dependency is the published
+# @voxgig/sdkgen, so a release of sdkgen or apidef that breaks a target is not
+# a push here, and only a timed run finds it.
+#
+# TWO DEPENDENCY LANES, because a `>=` floor makes "it passes" ambiguous:
+#
+#   current  what a consumer installing today resolves.
+#   floor    the oldest versions peerDependencies permits.
+#
+# The floor is READ from peerDependencies, never written here: two copies of
+# a version drift, and the one in a workflow is the one nobody looks at.
+#
+# `npm install`, NOT `npm ci`: this repository gitignores package-lock.json,
+# so there is no lockfile to install from.
+#
+# ubuntu only. The suite stages projects in a temporary directory, compiles
+# generated libraries with tsc and runs them in child processes. None of that
+# has been run on Windows or macOS, and a runner added untested would be red
+# on arrival.
+
+name: build
+
+on:
+  push:
+    branches: [ main ]
+  pull_request:
+    branches: [ main ]
+  schedule:
+    # Daily, off the hour: GitHub queues scheduled runs hardest on the hour.
+    - cron: '47 4 * * *'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+# A newer push to the same branch makes an in-flight run irrelevant.
+# Scheduled runs and runs on main are kept.
+concurrency:
+  group: build-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+jobs:
+  build:
+    name: build (${{ matrix.deps }} deps)
+
+    strategy:
+      fail-fast: false
+      matrix:
+        deps: [current, floor]
+
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
+        with:
+          node-version: 24.x
+
+      - name: Install
+        run: npm install --no-audit --no-fund
+
+      # Downgrade AFTER the install: npm would otherwise resolve these to the
+      # newest while satisfying everything else. `--no-save` keeps the
+      # manifest the one statement of what the floor is.
+      - name: Pin the declared floor
+        if: ${{ matrix.deps == 'floor' }}
+        run: |
+          set -euo pipefail
+          SDKGEN="$(node -p "require('./package.json').peerDependencies['@voxgig/sdkgen']")"
+          APIDEF="$(node -p "require('./package.json').peerDependencies['@voxgig/apidef']")"
+
+          # `>=4.44.0` -> `4.44.0`. A floor written any other way is not one
+          # version this lane can pin.
+          for R in "$SDKGEN" "$APIDEF"; do
+            case "$R" in
+              '>='[0-9]*) ;;
+              *) echo "::error::expected a >=x.y.z floor, got '$R' (sdkgen=$SDKGEN apidef=$APIDEF)"; exit 1 ;;
+            esac
+          done
+          SDKGEN="${SDKGEN#>=}"
+          APIDEF="${APIDEF#>=}"
+
+          echo "pinning @voxgig/sdkgen@$SDKGEN @voxgig/apidef@$APIDEF"
+          npm install --no-audit --no-fund --no-save \
+            "@voxgig/sdkgen@$SDKGEN" "@voxgig/apidef@$APIDEF"
+
+      - name: Report what is installed
+        run: |
+          node --version
+          node -p "['@voxgig/sdkgen','@voxgig/apidef','typescript'].map(n=>n+' '+require(n+'/package.json').version).join('\n')"
+
+      # Builds the components first, then runs the comment gate, the
+      # dependency gate and the suite.
+      - name: Test
+        run: npm test
+
+      - name: The comment gate's own tests
+        run: make comments-test
+
+      # This repository IS an sdkgen package, so its authoring check is a CI check.
+      - name: Check the package
+        run: npm run check-package
